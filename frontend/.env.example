# ── API URL ───────────────────────────────────────────────────────────────────
# For local dev: http://localhost:4000
# For production: https://your-backend-host.example.com
REACT_APP_API_URL=http://localhost:4000

# ── MENTOR SECRET PATH ────────────────────────────────────────────────────────
# Change this to something random before deploying!
# Students who visit this URL will see the mentor login
REACT_APP_MENTOR_PATH=/mentor
