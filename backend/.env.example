# ── DATABASE ──────────────────────────────────────────────────────────────────
# Leave blank/unset to use local JSON files in backend/db/ (fine for dev/testing,
# but data is lost if your host's disk isn't persistent — e.g. free Render/
# Railway web services).
#
# For real, free, long-running persistence, create a free Postgres instance at
# https://neon.tech (or Supabase/Railway) and paste its connection string below.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── CORS — comma-separated list of allowed frontend URLs ──────────────────────
# For local dev: http://localhost:3000
# For production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ── MENTOR CREDENTIALS ────────────────────────────────────────────────────────
# CHANGE THESE before deploying! Do not reuse a password you use anywhere else.
MENTOR_EMAIL=
MENTOR_PASSWORD=
MENTOR_NAME=
